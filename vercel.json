{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["fra1"],
  "functions": {
    "api/share.js": {
      "maxDuration": 30,
      "regions": ["fra1"]
    }
  },
  "headers": [
    {
      "source": "/api/share",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
